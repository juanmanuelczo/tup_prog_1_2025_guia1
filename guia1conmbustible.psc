Proceso ConsumoConmbustible
	Definir Km_rec, litros_cons, cons_km Como Real;
	Escribir "Ingrese la cantidad de kilómetros recorridos, ";
	Leer Km_rec;
	Escribir "Ingrese la cantidad de litros de combustible consumidos";
	Leer litros_cons;
	cons_km <- litros_cons/Km_rec;
	Escribir "El consumo de combustible por Kilómetro es " ,cons_km, " Litros";
	
	
	
FinProceso
