Proceso productos
	Definir precio, contado, trescuotas, seiscuotas, docecuotas como real;
	Escribir "Ingresar el costo del producto a pagar";
	Leer precio;
	contado <- precio*0.10;
	trescuotas <- precio*1.062;
	seiscuotas <- precio*1.18;
	docecuotas <- precio*1.41;
	Escribir "Precio al contado: ", contado ," pesos";
	Escribir "Precio en tres cuotas: ", trescuotas ," pesos";
	Escribir "Precio en seis cuotas: ", seiscuotas ," pesos"; 
	Escribir "Precio en doce cuotas: ", docecuotas ," pesos";



	
	
FinProceso
